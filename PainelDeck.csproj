<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041: precisa pras APIs do Windows de "tocando agora" (Media.cs) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>PainelDeck</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>PainelDeck</AssemblyName>
    <!-- deixa compilar fora do Windows (CI / checagem); não muda nada no seu PC -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- só pra ler a temperatura da CPU do LibreHardwareMonitor (WMI), quando ele estiver aberto -->
    <PackageReference Include="System.Management" Version="10.0.2" />
    <!-- temperatura de verdade da CPU no ajudante de sensores (precisa de admin + driver PawnIO: scripts\instalar-sensores.ps1) -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <None Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="scripts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="deck.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="CLAUDE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
