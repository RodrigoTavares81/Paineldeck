{
  // Copie para settings.json e ajuste.
  // "auto" = menor monitor que não é o principal. Também aceita 1, 2, 3...
  // Dica: escolha pelo ícone na bandeja → "Monitor do painel" (salva aqui sozinho).
  "monitor": "auto",
  "obs": {
    "url": "ws://127.0.0.1:4455",
    "password": ""
  },
  // atalhos globais: nome → teclas ("rest" = modo descanso, "record" = começa/para a gravação no OBS; "" desliga)
  "hotkeys": { "rest": "ctrl+alt+h", "record": "ctrl+alt+g" },
  // FPS do modo jogo (PresentMon em tools\, baixado pelo scripts\ativar-fps.ps1)
  "fps": { "enabled": true, "presentMon": "", "args": "" },
  // se o app der erro grave, abre de novo sozinho (no máximo 3x em 10 min)
  "autoRestart": true,
  // de onde vem a atualização do botão "Atualizar" (confere a cada 6h)
  "update": { "repo": "RodrigoTavares81/paineldeck", "branch": "main", "check": true }
}
