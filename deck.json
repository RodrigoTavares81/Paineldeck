// =====================================================================
//  PainelDeck — deck.json: TUDO que o painel faz fica aqui.
//  Salvou este arquivo → o painel atualiza sozinho (sem reiniciar o app).
//  Pode usar comentários // e vírgula sobrando no fim das listas.
// =====================================================================
//
//  Cada item de uma página é um BOTÃO ou um WIDGET:
//
//   Botão:  { "icon": "🎙️", "label": "Mic", "action": {...}, "color": "#ff3b5c" }
//   Widget: { "widget": "clock" }    (tipos: ferias, countdown, clock, stat — veja wwwroot/widgets.js)
//
//   "w" / "h"  → quantas colunas/linhas o item ocupa (padrão 1x1)
//   "page"     → em vez de action, troca de página (número ou nome): { "page": "OBS" }
//   "state"    → campo do status que deixa o botão "aceso" (ex.: "micMuted", "obs")
//   "on"       → ícone/texto quando aceso: { "icon": "🔇", "label": "Mutado" }
//
//  Tipos de action:
//   { "type": "keys",   "keys": "ctrl+shift+m" }            atalho de teclado
//   { "type": "type",   "text": "gg wp\n" }                 digita texto
//   { "type": "media",  "key": "playpause" }                playpause | next | prev | volup | voldown | volmute
//   { "type": "macro",  "steps": [ ... ] }                  sequência; um passo { "delay": 80 } espera em ms
//   { "type": "macro",  "ref": "gg" }                       usa uma macro da seção "macros" lá embaixo
//   { "type": "run",    "path": "notepad.exe", "args": "", "cwd": "" }   abre programa
//   { "type": "url",    "url": "https://..." }              abre link / protocolo (spotify:, steam://...)
//   { "type": "script", "file": "ola.ps1", "args": "", "hidden": true }  script da pasta /scripts (.ps1 .bat .cmd .py .js)
//   { "type": "mic",    "mode": "toggle" }                  toggle | mute | unmute (mic padrão do Windows)
//   { "type": "obs",    "request": "ToggleRecord", "data": {} }   qualquer request do obs-websocket v5
//   { "type": "games" }                                     abre a roda de jogos (lista "games" lá embaixo)
//   { "type": "macros" }                                    abre a gaveta com todas as macros de "macros"
//
//  Layout livre: página com "layout": "free" → cada item tem "x", "y", "w", "h" em % da tela (0–100)
//  e "z" opcional (maior fica por cima). Página sem "layout" usa a grade "grid" antiga (w/h em células);
//  o editor ✏️ converte pra % quando você salva.
//
//  "games": lista da roda de jogos → { "name": "...", "image": "games/arquivo.jpg", "action": {...} }
//  (imagens na pasta wwwroot/games)
//
//  MODO JOGO: o app percebe sozinho quando um jogo abre (pela pasta da Steam/Ubisoft/Epic/Xbox ou pelo .exe)
//  e troca o painel pra tela do jogo (na Navy: FPS, tempo da sessão e temperaturas no lugar das férias).
//  Campos opcionais em cada jogo de "games":
//   "process": "ForHonor.exe"                     reconhece pelo nome do .exe (ou lista ["a.exe", "b.exe"])
//   "macros": [ { "icon": "💬", "label": "gg", "action": {...} } ]   botões na tela do jogo (até 8)
//   "page": "For Honor"                           no clássico: página que abre junto com o jogo
//   "onStart" / "onStop": ação (ou lista)         roda quando o jogo abre / fecha
//  "gameMode": { "enabled": true, "detectUnknown": true, "idleMinutes": 10, "ignore": ["programa.exe"],
//                "libraries": ["D:\\Jogos"], "onStart": [...], "onStop": [...] }
//   detectUnknown = jogo fora da lista também conta (com o nome da pasta); idleMinutes = parado esse tempo não conta;
//   libraries = outras pastas onde ficam jogos. FPS: rode scripts/ativar-fps.ps1 uma vez (baixa o PresentMon).
//
//  "news": notícias da cena Navy (opcional) → { "title": "IA", "feeds": ["https://...rss"], "max": 18, "refreshMinutes": 20 }
//  (cabem 9 de uma vez; com mais, a lista troca de página sozinha; RSS ou Atom; sem essa seção usa o Google News sobre IA)
//  "navy": { "animacao": 10, "coluna": "claude" }
//   animacao = quadros por segundo do mar das férias na Navy (0 = tudo parado, gasta ainda menos GPU)
//   coluna   = o que vai na coluna da direita: "claude" (sessões do Claude Code do PC, padrão) ou "noticias"
//  "claude": sessões do Claude Code na Navy (opcional) →
//   { "hours": 72, "max": 14, "permissionMode": "acceptEdits", "allowedTools": "",
//     "whisper": { "exe": "C:\\...\\whisper-cli.exe", "model": "C:\\...\\ggml-large-v3-turbo-q5_0.bin", "language": "pt" } }
//   hours/max = quais sessões aparecem; permissionMode = o que o Claude pode fazer sozinho quando você manda mensagem pelo painel;
//   áudio: rode scripts/instalar-whisper.ps1 uma vez (sem Whisper usa o ditado do Windows, que precisa de internet)
// =====================================================================
